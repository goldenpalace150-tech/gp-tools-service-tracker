FROM docker.n8n.io/n8nio/n8n:2.46.6
ENV N8N_LISTEN_ADDRESS=127.0.0.1 N8N_PORT=5678 N8N_DIAGNOSTICS_ENABLED=false N8N_VERSION_NOTIFICATIONS_ENABLED=false N8N_PERSONALIZATION_ENABLED=false N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true N8N_BLOCK_ENV_ACCESS_IN_NODE=true N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true EXECUTIONS_DATA_SAVE_ON_SUCCESS=none EXECUTIONS_DATA_SAVE_ON_ERROR=none
WORKDIR /opt/raghad
